<mah:MetroWindow x:Class="SamaHesab.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding CompanyName}"
        WindowState="Maximized"
        MinWidth="1200" MinHeight="760"
        FlowDirection="RightToLeft"
        TitleCharacterCasing="Normal"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}"
        GlowBrush="{DynamicResource PrimaryAccent}"
        BorderThickness="0">

    <mah:MetroWindow.Resources>

        <!-- ─── Ribbon big button ─────────────────────────────────────────── -->
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Ribbon small QAT icon button ──────────────────────────────── -->
        <Style x:Key="QatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Tree nav group expander ───────────────────────────────────── -->
        <Style x:Key="NavExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
        </Style>

        <!-- ─── Tree nav leaf item ────────────────────────────────────────── -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="6,1" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Quick Access Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Ribbon -->
            <RowDefinition Height="*"/>      <!-- Nav + Workspace -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Quick Access Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,8">

                <!-- Company (right side in RTL) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PrimaryAccent}">
                        <materialDesign:PackIcon Kind="OfficeBuilding" Width="20" Height="20"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CompanyName}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Action cluster (left side in RTL) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayPersianDate}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Branch -->
                    <Button Style="{StaticResource QatButton}" Width="Auto" Padding="8,0"
                            Command="{Binding ChangeBranchCommand}" ToolTip="تغییر شعبه">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentBranch}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Calculator -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding OpenCalculatorCommand}" ToolTip="ماشین حساب">
                        <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20"/>
                    </Button>
                    <!-- Notifications -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowNotificationsCommand}" ToolTip="اعلان‌ها">
                        <materialDesign:Badged Badge="{Binding NotificationCount}" BadgeColorZoneMode="Accent">
                            <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <!-- Messages -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowMessagesCommand}" ToolTip="پیام‌ها">
                        <materialDesign:Badged Badge="{Binding MessageCount}" BadgeColorZoneMode="Accent">
                            <materialDesign:PackIcon Kind="EmailOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- User -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26"
                                                 Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource QatButton}" Command="{Binding LogoutCommand}" ToolTip="خروج">
                        <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" Foreground="{DynamicResource DangerColor}"/>
                    </Button>
                </StackPanel>

                <!-- Quick search (center, fills) -->
                <Border Background="{DynamicResource AppBackground}" CornerRadius="8"
                        Margin="20,0" MaxWidth="520" HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                 Margin="10,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Grid.Column="1" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="جستجوی سریع (Ctrl+F)"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══ Ribbon ═══ -->
        <TabControl Grid.Row="1" Background="{DynamicResource RibbonBackground}"
                    BorderThickness="0" Padding="0" Height="118">
            <TabItem Header="فایل">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel><materialDesign:PackIcon Kind="ViewDashboardOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="داشبورد" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel><materialDesign:PackIcon Kind="CogOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تنظیمات" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Backup">
                        <StackPanel><materialDesign:PackIcon Kind="DatabaseExportOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="پشتیبان‌گیری" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding LogoutCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="LogoutVariant" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource DangerColor}"/><TextBlock Text="خروج" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="حسابداری">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Vouchers">
                        <StackPanel><materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="اسناد حسابداری" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="VoucherEdit">
                        <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="ثبت سند" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts">
                        <StackPanel><materialDesign:PackIcon Kind="FileTreeOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="نمودار حساب‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <StackPanel><materialDesign:PackIcon Kind="ChartBoxOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="گزارش‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="خزانه‌داری">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Cheques">
                        <StackPanel><materialDesign:PackIcon Kind="CheckbookArrowRight" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="مدیریت چک" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts">
                        <StackPanel><materialDesign:PackIcon Kind="BankOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="حساب‌های بانکی" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="فروش">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice">
                        <StackPanel><materialDesign:PackIcon Kind="CartArrowRight" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="فاکتور فروش" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList">
                        <StackPanel><materialDesign:PackIcon Kind="FormatListBulletedSquare" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="لیست فروش" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="POS">
                        <StackPanel><materialDesign:PackIcon Kind="CashRegister" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="صندوق فروش" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="خرید">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice">
                        <StackPanel><materialDesign:PackIcon Kind="CartArrowDown" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="فاکتور خرید" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="انبار">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Products">
                        <StackPanel><materialDesign:PackIcon Kind="PackageVariantClosed" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کالاها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Warehouses">
                        <StackPanel><materialDesign:PackIcon Kind="Warehouse" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="انبارها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust">
                        <StackPanel><materialDesign:PackIcon Kind="SwapHorizontal" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تعدیل موجودی" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="مشتریان">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                        <StackPanel><materialDesign:PackIcon Kind="AccountGroupOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="مشتریان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Suppliers">
                        <StackPanel><materialDesign:PackIcon Kind="TruckOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تأمین‌کنندگان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="گزارشات">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <StackPanel><materialDesign:PackIcon Kind="ChartBar" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="گزارش‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <TabItem Header="مدیریت سیستم">
                <WrapPanel Margin="10,6">
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Employees">
                        <StackPanel><materialDesign:PackIcon Kind="AccountTieOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کارکنان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Salary">
                        <StackPanel><materialDesign:PackIcon Kind="CashMultiple" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="حقوق و دستمزد" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Attendance">
                        <StackPanel><materialDesign:PackIcon Kind="CalendarCheckOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="حضور و غیاب" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel><materialDesign:PackIcon Kind="CogOutline" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تنظیمات" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <!-- ═══ Nav (right) + Workspace (left) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Workspace tabs -->
            <TabControl Grid.Column="0" Margin="8"
                        ItemsSource="{Binding OpenTabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"/>
                            <Button Width="18" Height="18" Margin="8,0,0,0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Visibility="{Binding CanClose, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource AppBackground}">
                            <ContentControl Content="{Binding Content}"/>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Tree navigation -->
            <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel>
                        <TextBlock Text="منوی اصلی" Foreground="#64748B" FontSize="11"
                                   Margin="16,6,16,8"/>

                        <Expander Header="حسابداری" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Vouchers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="اسناد حسابداری" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileTreeOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="نمودار حساب‌ها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBoxOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="گزارش‌ها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="خزانه‌داری" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Cheques">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CheckbookArrowRight" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="مدیریت چک" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BankOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="حساب‌های بانکی" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="فروش" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CartArrowRight" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="فاکتور فروش" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FormatListBulletedSquare" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="لیست فروش" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="POS">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashRegister" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="صندوق فروش" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="خرید" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CartArrowDown" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="فاکتور خرید" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="انبار" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Products">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PackageVariantClosed" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="کالاها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Warehouses">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Warehouse" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="انبارها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تعدیل موجودی" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="مشتریان" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="مشتریان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Suppliers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TruckOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تأمین‌کنندگان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="منابع انسانی" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Employees">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountTieOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="کارکنان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Salary">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="حقوق و دستمزد" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Attendance">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CalendarCheckOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="حضور و غیاب" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="سیستم" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تنظیمات" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Backup">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DatabaseExportOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="پشتیبان‌گیری" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource SidebarBackground}" Height="28">
            <DockPanel LastChildFill="False" Margin="14,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="سماع رایانه کیش | سما حساب ۱.۰.۰ | kishwifi.com"
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentBranch}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding TodayPersianDate}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
