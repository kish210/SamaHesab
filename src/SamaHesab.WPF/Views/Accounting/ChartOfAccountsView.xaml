<UserControl x:Class="SamaHesab.WPF.Views.Accounting.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:acc="clr-namespace:SamaHesab.WPF.ViewModels.Accounting"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ حساب جدید"  Style="{StaticResource PrimaryButton}"   Height="36" Margin="0,0,6,0" Command="{Binding AddAccountCommand}"/>
                <Button Content="✏ ویرایش"       Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding EditAccountCommand}"/>
                <Button Content="🗑 حذف"          Style="{StaticResource DangerButton}"    Height="36" Margin="0,0,6,0" Command="{Binding DeleteAccountCommand}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="10,4"/>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Width="220">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}" Padding="10,8"
                             FontFamily="{StaticResource VazirFont}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Account Tree -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <TreeView ItemsSource="{Binding RootAccounts}" Background="Transparent"
                          BorderThickness="0" SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type acc:AccountTreeNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <TextBlock Text="{Binding Code}" Width="90" Foreground="{DynamicResource SecondaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                                           FontFamily="{StaticResource VazirFont}"/>
                                <TextBlock Text="{Binding Balance, StringFormat=' ({0:N0})'}"
                                           Foreground="{DynamicResource WarningColor}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- Account Detail Panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" Padding="20">
                <StackPanel Visibility="{Binding HasSelectedAccount, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="مشخصات حساب" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               FontFamily="{StaticResource VazirFont}" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="کد حساب:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.Code}"
                                   Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" FontSize="14"
                                   FontFamily="{StaticResource VazirFont}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="نام حساب:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.Name}"
                                   Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="سطح حساب:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.Level}"
                                   Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ماهیت:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.Nature}"
                                   Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SeparatorColor}" Margin="0,12"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="مانده حساب:" FontWeight="Bold" FontFamily="{StaticResource VazirFont}"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="{Binding SelectedAccountBalance, StringFormat='{}{0:N0} ریال'}"
                                   HorizontalAlignment="Left" FontWeight="Bold" FontSize="18"
                                   Foreground="{DynamicResource WarningColor}"
                                   FontFamily="{StaticResource VazirFont}"/>
                    </Grid>

                    <Button Content="📋 مشاهده دفتر کل" Style="{StaticResource PrimaryButton}"
                            Height="38" Margin="0,16,0,0"
                            Command="{Binding ViewLedgerCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

