<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         SAMA HESAB - Dark Theme
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Primary Colors -->
    <Color x:Key="PrimaryAccentColor">#2563EB</Color>
    <Color x:Key="PrimaryAccentHoverColor">#1D4ED8</Color>
    <Color x:Key="SecondaryAccentColor">#7C3AED</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColorVal">#D97706</Color>
    <Color x:Key="DangerColorVal">#DC2626</Color>
    <Color x:Key="InfoColor">#0891B2</Color>

    <!-- Background Colors -->
    <Color x:Key="AppBackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceBackgroundColor">#1E293B</Color>
    <Color x:Key="CardBackgroundColor">#253047</Color>
    <Color x:Key="SidebarBackgroundColor">#0F172A</Color>
    <Color x:Key="RibbonBackgroundColor">#1E293B</Color>
    <Color x:Key="InputBackgroundColor">#1E293B</Color>
    <Color x:Key="TableRowBgColor">#1E293B</Color>
    <Color x:Key="TableAltRowBgColor">#253047</Color>
    <Color x:Key="TableHeaderBgColor">#0F172A</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#F1F5F9</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>
    <Color x:Key="DisabledTextColor">#475569</Color>
    <Color x:Key="InputBorderColor">#334155</Color>
    <Color x:Key="BorderColorVal">#334155</Color>
    <Color x:Key="SeparatorColorVal">#334155</Color>
    <Color x:Key="SidebarTextColor">#CBD5E1</Color>
    <Color x:Key="SidebarActiveTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarActiveBgColor">#2563EB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackground"         Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBackground"     Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackground"        Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackground"     Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="RibbonBackground"      Color="{StaticResource RibbonBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackground"       Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TableRowBg"            Color="{StaticResource TableRowBgColor}"/>
    <SolidColorBrush x:Key="TableAltRowBg"         Color="{StaticResource TableAltRowBgColor}"/>
    <SolidColorBrush x:Key="TableHeaderBg"         Color="{StaticResource TableHeaderBgColor}"/>
    <SolidColorBrush x:Key="PrimaryText"           Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryText"         Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DisabledText"          Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="InputBorder"           Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="BorderColor"           Color="{StaticResource BorderColorVal}"/>
    <SolidColorBrush x:Key="SeparatorColor"        Color="{StaticResource SeparatorColorVal}"/>
    <SolidColorBrush x:Key="SidebarText"           Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarActiveText"     Color="{StaticResource SidebarActiveTextColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBg"       Color="{StaticResource SidebarActiveBgColor}"/>
    <SolidColorBrush x:Key="PrimaryAccent"         Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SuccessColor"          Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningColor"          Color="{StaticResource WarningColorVal}"/>
    <SolidColorBrush x:Key="DangerColor"           Color="{StaticResource DangerColorVal}"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusDraft"    Color="#64748B"/>
    <SolidColorBrush x:Key="StatusPosted"   Color="#059669"/>
    <SolidColorBrush x:Key="StatusCancelled" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusPending"  Color="#D97706"/>

</ResourceDictionary>
