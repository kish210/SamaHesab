<Application x:Class="SamaHesab.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Themes/Base.xaml"/>
                <ResourceDictionary Source="Assets/Themes/Dark.xaml"/>
                <ResourceDictionary Source="Assets/Themes/Colors.xaml"/>
                <ResourceDictionary Source="Assets/Themes/Styles.xaml"/>
                <ResourceDictionary Source="Assets/Themes/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
