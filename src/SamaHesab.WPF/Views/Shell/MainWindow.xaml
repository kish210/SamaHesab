                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Warehouses">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Warehouse" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="انبارها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تعدیل موجودی" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="مشتریان" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="مشتریان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Suppliers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TruckOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تأمین‌کنندگان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="منابع انسانی" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Employees">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountTieOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="کارکنان" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Salary">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="حقوق و دستمزد" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Attendance">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CalendarCheckOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="حضور و غیاب" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="سیستم" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="تنظیمات" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Backup">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DatabaseExportOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="پشتیبان‌گیری" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource SidebarBackground}" Height="28">
            <DockPanel LastChildFill="False" Margin="14,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="سماع رایانه کیش | سما حساب ۱.۰.۰ | kishwifi.com"
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentBranch}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding TodayPersianDate}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
