<UserControl x:Class="SamaHesab.WPF.Views.Inventory.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Search -->
            <RowDefinition Height="*"/>
            <!-- Grid -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ کالای جدید" Style="{StaticResource PrimaryButton}"
                        Height="36" Margin="0,0,6,0"
                        Command="{Binding NewProductCommand}"/>
                <Button Content="✏ ویرایش" Style="{StaticResource SecondaryButton}"
                        Height="36" Margin="0,0,6,0"
                        Command="{Binding EditProductCommand}"/>
                <Button Content="🗑 حذف" Style="{StaticResource DangerButton}"
                        Height="36" Margin="0,0,6,0"
                        Command="{Binding DeleteProductCommand}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="6,4"/>
                <Button Content="📊 خروجی اکسل" Style="{StaticResource SecondaryButton}"
                        Height="36" Margin="0,0,6,0"
                        Command="{Binding ExportExcelCommand}"/>
                <Button Content="↻ بروزرسانی" Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- Stats Row -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Padding="16,8"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}">
                    <Run Text="کل کالاها: "/>
                    <Run Text="{Binding TotalCount}" Foreground="{DynamicResource PrimaryText}"
                         FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="  |  " Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}">
                    <Run Text="فعال: "/>
                    <Run Text="{Binding ActiveCount}" Foreground="{DynamicResource SuccessColor}"
                         FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" Padding="16,10"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource InputBackground}"
                        CornerRadius="6" BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}"
                                 Padding="8,8" FontFamily="{StaticResource VazirFont}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="کد / بارکد / نام" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PlaceholderText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <ComboBox Grid.Column="1" Margin="0,0,8,0"
                          ItemsSource="{Binding Groups}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedGroupId}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}">
                            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <Button Grid.Column="2" Content="جستجو"
                        Style="{StaticResource PrimaryButton}" Height="36"
                        Command="{Binding SearchCommand}"/>
            </Grid>
        </Border>

        <!-- Product Grid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  BorderThickness="0"
                  RowHeight="42" ColumnHeaderHeight="44"
                  Background="{DynamicResource TableRowBg}"
                  Foreground="{DynamicResource PrimaryText}"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="120"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="قیمت فروش"
                                    Binding="{Binding SalePrice, StringFormat='{}{0:N0}'}"
                                    Width="130"/>
                <DataGridTextColumn Header="قیمت خرید"
                                    Binding="{Binding PurchasePrice, StringFormat='{}{0:N0}'}"
                                    Width="130"/>
                <DataGridTextColumn Header="قیمت عمده"
                                    Binding="{Binding WholesalePrice, StringFormat='{}{0:N0}'}"
                                    Width="130"/>
                <DataGridTextColumn Header="حداقل موجودی"
                                    Binding="{Binding MinStock, StringFormat='{}{0:N2}'}"
                                    Width="110"/>
                <DataGridTemplateColumn Header="وضعیت" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A3A2B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#3A1A1A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource VazirFont}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="فعال"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="غیرفعال"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="RightToLeft">
                    <MenuItem Header="ویرایش" Command="{Binding DataContext.EditProductCommand,
                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="حذف" Command="{Binding DataContext.DeleteProductCommand,
                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="مشاهده موجودی"/>
                    <MenuItem Header="تاریخچه تراکنش‌ها"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
