                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="خرید" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CartArrowDown" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="فاکتور خرید" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="انبار" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Products">
