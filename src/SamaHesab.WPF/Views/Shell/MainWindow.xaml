<mah:MetroWindow x:Class="SamaHesab.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="{Binding CompanyName}"
        WindowState="Maximized"
        MinWidth="1200" MinHeight="760"
        FlowDirection="RightToLeft"
        TitleCharacterCasing="Normal"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}"
        GlowBrush="{DynamicResource PrimaryAccent}"
        BorderThickness="0">

    <mah:MetroWindow.Resources>

        <!-- ─── Ribbon big button ─────────────────────────────────────────── -->
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Ribbon small QAT icon button ──────────────────────────────── -->
        <Style x:Key="QatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Tree nav group expander ───────────────────────────────────── -->
        <Style x:Key="NavExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
        </Style>

        <!-- ─── Tree nav leaf item ────────────────────────────────────────── -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="6,1" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Quick Access Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Ribbon -->
            <RowDefinition Height="*"/>      <!-- Nav + Workspace -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Quick Access Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,8">

                <!-- Company (right side in RTL) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PrimaryAccent}">
                        <materialDesign:PackIcon Kind="OfficeBuilding" Width="20" Height="20"
                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CompanyName}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Action cluster (left side in RTL) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayPersianDate}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Branch -->
                    <Button Style="{StaticResource QatButton}" Width="Auto" Padding="8,0"
                            Command="{Binding ChangeBranchCommand}" ToolTip="تغییر شعبه">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentBranch}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Calculator -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding OpenCalculatorCommand}" ToolTip="ماشین حساب">
                        <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20"/>
                    </Button>
                    <!-- Notifications -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowNotificationsCommand}" ToolTip="اعلان‌ها">
                        <materialDesign:Badged Badge="{Binding NotificationCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <!-- Messages -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowMessagesCommand}" ToolTip="پیام‌ها">
                        <materialDesign:Badged Badge="{Binding MessageCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="EmailOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- User -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26"
                                                 Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource QatButton}" Command="{Binding LogoutCommand}" ToolTip="خروج">
                        <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" Foreground="{DynamicResource DangerColor}"/>
                    </Button>
                </StackPanel>

                <!-- Quick search (center, fills) -->
                <Border Background="{DynamicResource AppBackground}" CornerRadius="8"
                        Margin="20,0" MaxWidth="520" HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                 Margin="10,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Grid.Column="1" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="جستجوی سریع (Ctrl+F)"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══ Office-style Ribbon (Telerik RadRibbonView) ═══ -->
        <telerik:RadRibbonView Grid.Row="1" x:Name="ribbon" ApplicationName="سما حساب"
                               Title="" SelectedIndex="0" BorderThickness="0"
                               FlowDirection="RightToLeft">
            <telerik:RadRibbonTab Header="خانه">
                <telerik:RadRibbonGroup Header="عمومی">
                    <telerik:RadRibbonButton Text="داشبورد" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <telerik:RadRibbonButton Text="گزارش‌ها" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                    <telerik:RadRibbonButton Text="خروج" Size="Large"
                        Command="{Binding LogoutCommand}"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="حسابداری">
                <telerik:RadRibbonGroup Header="اسناد">
                    <telerik:RadRibbonButton Text="ثبت سند" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="VoucherEdit"/>
                    <telerik:RadRibbonButton Text="اسناد حسابداری" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Vouchers"/>
                </telerik:RadRibbonGroup>
                <telerik:RadRibbonGroup Header="کدینگ و گزارش">
                    <telerik:RadRibbonButton Text="نمودار حساب‌ها" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts"/>
                    <telerik:RadRibbonButton Text="گزارش‌ها" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="خزانه‌داری">
                <telerik:RadRibbonGroup Header="دریافت و پرداخت">
                    <telerik:RadRibbonButton Text="مدیریت چک" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Cheques"/>
                    <telerik:RadRibbonButton Text="حساب‌های بانکی" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="BankAccounts"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="فروش">
                <telerik:RadRibbonGroup Header="فروش">
                    <telerik:RadRibbonButton Text="فاکتور فروش" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice"/>
                    <telerik:RadRibbonButton Text="لیست فروش" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList"/>
                    <telerik:RadRibbonButton Text="صندوق فروش" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="POS"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="خرید">
                <telerik:RadRibbonGroup Header="خرید">
                    <telerik:RadRibbonButton Text="فاکتور خرید" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="انبار">
                <telerik:RadRibbonGroup Header="کالا و موجودی">
                    <telerik:RadRibbonButton Text="کالاها" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                    <telerik:RadRibbonButton Text="انبارها" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Warehouses"/>
                    <telerik:RadRibbonButton Text="تعدیل موجودی" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="StockAdjust"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="اشخاص">
                <telerik:RadRibbonGroup Header="طرف‌حساب‌ها">
                    <telerik:RadRibbonButton Text="مشتریان" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                    <telerik:RadRibbonButton Text="تأمین‌کنندگان" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>

            <telerik:RadRibbonTab Header="مدیریت سیستم">
                <telerik:RadRibbonGroup Header="منابع انسانی">
                    <telerik:RadRibbonButton Text="کارکنان" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Employees"/>
                    <telerik:RadRibbonButton Text="حقوق و دستمزد" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Salary"/>
                    <telerik:RadRibbonButton Text="حضور و غیاب" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Attendance"/>
                </telerik:RadRibbonGroup>
                <telerik:RadRibbonGroup Header="سیستم">
                    <telerik:RadRibbonButton Text="تنظیمات" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    <telerik:RadRibbonButton Text="پشتیبان‌گیری" Size="Large"
                        Command="{Binding NavigateCommand}" CommandParameter="Backup"/>
                </telerik:RadRibbonGroup>
            </telerik:RadRibbonTab>
        </telerik:RadRibbonView>

        <!-- (old flat command bar removed) -->
        <Border Grid.Row="1" Visibility="Collapsed">
            <ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="8,6">
                    <!-- فایل -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel><materialDesign:PackIcon Kind="ViewDashboardOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="داشبورد" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- حسابداری -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Vouchers">
                        <StackPanel><materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="اسناد" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="VoucherEdit">
                        <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="ثبت سند" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts">
                        <StackPanel><materialDesign:PackIcon Kind="FileTreeOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="حساب‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- خزانه‌داری -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Cheques">
                        <StackPanel><materialDesign:PackIcon Kind="CheckbookArrowRight" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="چک‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts">
                        <StackPanel><materialDesign:PackIcon Kind="BankOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="بانک" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- فروش -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice">
                        <StackPanel><materialDesign:PackIcon Kind="CartArrowRight" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="فاکتور فروش" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList">
                        <StackPanel><materialDesign:PackIcon Kind="FormatListBulletedSquare" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="لیست فروش" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="POS">
                        <StackPanel><materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="صندوق" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- خرید -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice">
                        <StackPanel><materialDesign:PackIcon Kind="CartArrowDown" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="فاکتور خرید" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- انبار -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Products">
                        <StackPanel><materialDesign:PackIcon Kind="PackageVariantClosed" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کالاها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Warehouses">
                        <StackPanel><materialDesign:PackIcon Kind="Warehouse" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="انبارها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust">
                        <StackPanel><materialDesign:PackIcon Kind="SwapHorizontal" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تعدیل" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- مشتریان -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                        <StackPanel><materialDesign:PackIcon Kind="AccountGroupOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="مشتریان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Suppliers">
                        <StackPanel><materialDesign:PackIcon Kind="TruckOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تأمین‌کنندگان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- گزارشات -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <StackPanel><materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="گزارش‌ها" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource BorderColor}"/>
                    <!-- مدیریت سیستم -->
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Employees">
                        <StackPanel><materialDesign:PackIcon Kind="AccountTieOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کارکنان" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Salary">
                        <StackPanel><materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="حقوق" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel><materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="تنظیمات" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Command="{Binding LogoutCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="LogoutVariant" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource DangerColor}"/><TextBlock Text="خروج" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ Nav (right) + Workspace (left) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Workspace: Telerik RadDocking (MDI document host) -->
            <telerik:RadDocking Grid.Column="0" x:Name="docking" Margin="4"
                                Close="Docking_Close" BorderThickness="0"
                                HasDocumentHost="True">
                <telerik:RadDocking.DocumentHost>
                    <telerik:RadSplitContainer>
                        <telerik:RadPaneGroup x:Name="docGroup"/>
                    </telerik:RadSplitContainer>
                </telerik:RadDocking.DocumentHost>
            </telerik:RadDocking>

            <!-- Tree navigation -->
            <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}">
                <Border.Resources>
                    <!-- Sidebar is dark, so force light text for all labels inside -->
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel>
                        <TextBlock Text="منوی اصلی" Foreground="#64748B" FontSize="11"
                                   Margin="16,6,16,8"/>

                        <Expander Header="حسابداری" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Vouchers">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="اسناد حسابداری" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileTreeOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="نمودار حساب‌ها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBoxOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="گزارش‌ها" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="خزانه‌داری" Style="{StaticResource NavExpander}">
                            <StackPanel>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="Cheques">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CheckbookArrowRight" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="مدیریت چک" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts">
