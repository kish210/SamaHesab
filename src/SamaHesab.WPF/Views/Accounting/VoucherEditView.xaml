<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F9"  Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F10" Command="{Binding PostCommand}"/>
        <KeyBinding Key="F2"  Command="{Binding NewCommand}"/>
        <KeyBinding Key="F8"  Command="{Binding PrintCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="📋 جدید (F2)"    Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding NewCommand}"/>
                <Button Content="💾 ذخیره (F9)"   Style="{StaticResource PrimaryButton}"   Height="36" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                <Button Content="✓ قطعی (F10)"   Style="{StaticResource SuccessButton}"   Height="36" Margin="0,0,6,0" Command="{Binding PostCommand}"/>
                <Button Content="↩ برگشت سند"    Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding ReverseCommand}"/>
                <Button Content="🖨 چاپ (F8)"     Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding PrintCommand}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="10,4"/>
                <TextBlock Text="سند شماره: " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                <TextBlock Text="{Binding VoucherNumber}" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningColor}" FontWeight="Bold" FontSize="16"
                           FontFamily="{StaticResource VazirFont}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="10,4"/>
                <Border Background="#05966920" CornerRadius="12" Padding="10,4"
                        Visibility="{Binding IsBalanced, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="✓ سند تراز است" Foreground="#059669"
                               FontFamily="{StaticResource VazirFont}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Header Fields -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="تاریخ سند *" Style="{StaticResource FormLabel}"/>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding VoucherDate, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}" Padding="10,8"
                                 FontFamily="{StaticResource VazirFont}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="نوع سند" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding VoucherTypes}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedVoucherTypeId}" Height="36">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="مرکز هزینه" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding CostCenters}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedCostCenterId}" Height="36">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="شرح کلی سند" Style="{StaticResource FormLabel}"/>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}" Padding="10,8"
                                 FontFamily="{StaticResource VazirFont}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add Row Controls -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Quick Add Row -->
                <Border Background="{DynamicResource CardBackground}" Padding="12,8"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                            <TextBox Text="{Binding NewRowNumber}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="8,6" FontFamily="{StaticResource VazirFont}" IsReadOnly="True"/>
                        </Border>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LeafAccounts}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding NewAccountId}"
                                  Margin="0,0,6,0" Height="34">
                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                        </ComboBox>
                        <Border Grid.Column="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                                     Padding="8,6" FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource InputBackground}" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                            <TextBox Text="{Binding NewDebit, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                     Background="Transparent" BorderThickness="0" Foreground="#2563EB"
                                     Padding="8,6" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource InputBackground}" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                            <TextBox Text="{Binding NewCredit, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                     Background="Transparent" BorderThickness="0" Foreground="#DC2626"
                                     Padding="8,6" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                        </Border>
                        <Button Grid.Column="5" Content="+ افزودن" Style="{StaticResource PrimaryButton}"
                                Height="34" Command="{Binding AddRowCommand}"/>
                    </Grid>
                </Border>

                <!-- Items DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                          CanUserAddRows="False" BorderThickness="0" RowHeight="42" ColumnHeaderHeight="44"
                          Background="{DynamicResource TableRowBg}" Foreground="{DynamicResource PrimaryText}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ردیف"    Binding="{Binding RowNumber}" Width="55"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="کد حساب" Binding="{Binding AccountCode}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="نام حساب" Binding="{Binding AccountName}" Width="*"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="شرح"     Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <DataGridTextColumn Header="بدهکار"  Binding="{Binding Debit,  StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerColor}"
                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Totals Footer -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="20,10" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="جمع بدهکار: " Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding TotalDebit, StringFormat='{}{0:N0}'}"
                                       Foreground="#2563EB" FontWeight="Bold" FontSize="16"
                                       FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="20,10" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="جمع بستانکار: " Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding TotalCredit, StringFormat='{}{0:N0}'}"
                                       Foreground="#DC2626" FontWeight="Bold" FontSize="16"
                                       FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="20,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                        <Setter Property="Background" Value="#05966920"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBalanced}" Value="False">
                                        <Setter Property="Background" Value="#DC262620"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="مانده: " Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding Difference, StringFormat='{}{0:N0}'}"
                                       FontWeight="Bold" FontSize="16" FontFamily="{StaticResource VazirFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                                <Setter Property="Foreground" Value="#059669"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBalanced}" Value="False">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
