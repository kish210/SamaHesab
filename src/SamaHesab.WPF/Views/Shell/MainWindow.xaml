<Window x:Class="SamaHesab.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="سامانه جامع سما حساب"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="26"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>  <!-- Sidebar -->
                <ColumnDefinition Width="*"/>    <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 TITLE BAR
            ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + App Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#2563EB" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="6" Opacity="0.6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="سما حساب" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>

                    <!-- Company + User + Theme Switch -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="20" Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CompanyName}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="20" Padding="12,4" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TodayPersianDate}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                FlowDirection="LeftToRight">
                        <Button Content="🌙" Width="32" Height="28" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleThemeCommand}" ToolTip="تغییر تم"/>
                        <Button Content="👤" Width="32" Height="28" Style="{StaticResource IconButton}"
                                Command="{Binding UserProfileCommand}" ToolTip="{Binding CurrentUserName}"/>
                        <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="4,6"/>
                        <Button Content="─" Width="32" Height="28" Style="{StaticResource IconButton}"
                                Click="Minimize_Click"/>
                        <Button Content="□" Width="32" Height="28" Style="{StaticResource IconButton}"
                                Click="Maximize_Click"/>
                        <Button Content="✕" Width="32" Height="28" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource DangerColor}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 SIDEBAR
            ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- User Card -->
                    <Border DockPanel.Dock="Top" Margin="12,16,12,8"
                            Background="#1E3A5F" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold"
                                               Foreground="White" FontFamily="{StaticResource VazirFont}" FontSize="13"/>
                                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="#94A3B8"
                                               FontFamily="{StaticResource VazirFont}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="38" Height="38" Fill="#2563EB"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logout at bottom -->
                    <Button DockPanel.Dock="Bottom" Content="🚪  خروج از سیستم"
                            Style="{StaticResource SidebarItemButton}"
                            Foreground="#DC2626"
                            Command="{Binding LogoutCommand}"
                            Margin="8,8,8,16"/>

                    <!-- Navigation Items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0">

                            <!-- Dashboard -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveMenu}" Value="Dashboard">
                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="داشبورد" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Separator -->
                            <TextBlock Text="حسابداری" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Vouchers">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Vouchers"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="📋" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="اسناد حسابداری" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="ChartOfAccounts"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🌲" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="نمودار حساب‌ها" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Cheques">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Cheques"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🏦" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="مدیریت چک" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="فروش" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="SalesInvoice"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🧾" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="فاکتور فروش" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="POS">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="POS"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🖥" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="صندوق فروش (POS)" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="خرید" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="PurchaseInvoice"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="📦" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="فاکتور خرید" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="انبار" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Products">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Products"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🏷" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="کالاها" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Warehouses">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Warehouses"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🏭" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="انبارها" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="مشتریان" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Customers">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Customers"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="👥" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="مشتریان" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Suppliers">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Suppliers"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🏪" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="تأمین‌کنندگان" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="منابع انسانی" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Employees">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Employees"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="👔" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="کارکنان" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Salary">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Salary"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="💰" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="حقوق و دستمزد" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="گزارش‌ها" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Reports">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Reports"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="📈" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="گزارش‌ها" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <TextBlock Text="تنظیمات" Foreground="#475569" FontSize="10" FontWeight="Bold"
                                       Margin="20,12,20,4" FontFamily="{StaticResource VazirFont}"/>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Settings"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="تنظیمات" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Backup">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveMenu}" Value="Backup"><Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="💾" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="پشتیبان‌گیری" FontFamily="{StaticResource VazirFont}" VerticalAlignment="Center"/></StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 MAIN CONTENT AREA
            ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Grid.Column="1">
                <!-- Loading Overlay -->
                <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"
                        Panel.ZIndex="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                        <TextBlock Text="{Binding LoadingMessage}" Foreground="White"
                                   FontFamily="{StaticResource VazirFont}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Page Content -->
                <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 STATUS BAR
            ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="#059669" Margin="0,0,6,0"/>
                        <TextBlock Text="متصل به پایگاه داده" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="11"/>
                        <Separator Width="1" Background="{DynamicResource SeparatorColor}" Margin="12,4"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="نسخه ۱.۰.۰" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="11"/>
                        <Separator Width="1" Background="{DynamicResource SeparatorColor}" Margin="12,4"/>
                        <TextBlock Text="سما نرم‌افزار" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
