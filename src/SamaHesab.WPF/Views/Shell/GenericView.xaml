<UserControl x:Class="SamaHesab.WPF.Views.Shell.GenericView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🚧" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="این بخش در دست توسعه است" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"
                       FontFamily="{StaticResource VazirFont}"
                       HorizontalAlignment="Center" Margin="0,16,0,8"/>
            <TextBlock Text="به زودی در نسخه‌های بعدی اضافه می‌شود" FontSize="14"
                       Foreground="{DynamicResource SecondaryText}"
                       FontFamily="{StaticResource VazirFont}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
