<UserControl x:Class="SamaHesab.WPF.Views.Sales.SalesInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F9"  Command="{Binding PostInvoiceCommand}"/>
        <KeyBinding Key="F2"  Command="{Binding NewInvoiceCommand}"/>
        <KeyBinding Key="F7"  Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="F8"  Command="{Binding PrintCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="📋 جدید (F2)"       Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding NewInvoiceCommand}"/>
                <Button Content="💾 پیش‌نویس (F7)"   Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding SaveDraftCommand}"/>
                <Button Content="✓ قطعی کردن (F9)"   Style="{StaticResource SuccessButton}"   Height="36" Margin="0,0,6,0" Command="{Binding PostInvoiceCommand}"/>
                <Button Content="🖨 چاپ (F8)"         Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding PrintCommand}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="10,4"/>
                <TextBlock Text="فاکتور شماره: " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                <TextBlock Text="{Binding InvoiceNumber}" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningColor}" FontWeight="Bold" FontSize="16"
                           FontFamily="{StaticResource VazirFont}"/>
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="مشتری *" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCustomerId}" Height="36">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="انبار *" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}" Height="36">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="تاریخ *" Style="{StaticResource FormLabel}"/>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding InvoiceDate}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="سطح قیمت" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding PriceLevels}" SelectedItem="{Binding PriceLevel}" Height="36">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product Search -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="2" CornerRadius="6" Margin="0,0,8,0">
                    <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                             Padding="10,8" FontFamily="{StaticResource VazirFont}" FontSize="14">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchProductCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                    <TextBox Text="{Binding AddQty, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                    <TextBox Text="{Binding AddUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SuccessColor}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="3" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                    <TextBox Text="{Binding AddDiscountPct, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DangerColor}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                    <TextBox Text="{Binding AddTaxPct, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WarningColor}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                </Border>
                <Button Grid.Column="5" Content="+ افزودن" Style="{StaticResource PrimaryButton}" Height="36" Command="{Binding SearchProductCommand}"/>
            </Grid>
        </Border>

        <!-- Items DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0"
                  RowHeight="42" ColumnHeaderHeight="44"
                  Background="{DynamicResource TableRowBg}" Foreground="{DynamicResource PrimaryText}"
                  AlternatingRowBackground="{DynamicResource TableAltRowBg}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ردیف"   Binding="{Binding RowNumber}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="کد"     Binding="{Binding ProductCode}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="تعداد"  Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="تخفیف %" Binding="{Binding DiscountPct, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridTextColumn Header="مالیات %" Binding="{Binding TaxPct, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridTextColumn Header="مبلغ خالص" Binding="{Binding NetAmount, StringFormat='{}{0:N0}'}" Width="130" IsReadOnly="True"/>
                <DataGridTemplateColumn Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerColor}"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals + Payment -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>

                <!-- Payment -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="نوع پرداخت:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}" Width="130" Height="34">
                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="مبلغ پرداختی:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Width="140">
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SuccessColor}" Padding="10,7" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="توضیحات:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Width="200">
                            <TextBox Text="{Binding Description}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,7" FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Totals -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="جمع کل:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="تخفیف:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding TotalDiscount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" Foreground="{DynamicResource DangerColor}" FontFamily="{StaticResource VazirFont}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="مالیات:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding TotalTax, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" Foreground="{DynamicResource WarningColor}" FontFamily="{StaticResource VazirFont}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorColor}" Margin="0,4"/>
                        <Grid>
                            <TextBlock Text="مبلغ کل:" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} ریال'}" HorizontalAlignment="Left" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource WarningColor}" FontFamily="{StaticResource VazirFont}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="مانده:" Foreground="{DynamicResource SecondaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <TextBlock Text="{Binding RemainAmount, StringFormat='{}{0:N0} ریال'}" HorizontalAlignment="Left" Foreground="{DynamicResource DangerColor}" FontFamily="{StaticResource VazirFont}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
